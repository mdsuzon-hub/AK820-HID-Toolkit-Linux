# Must sort before 73-seat-late.rules for uaccess to apply -> keep the 70- prefix.
# hidraw: knob/button reports
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="505b", MODE="0660", TAG+="uaccess"
# evdev: read Ctrl/Shift state + grab the knob device to filter volume keys
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="320f", ATTRS{id/product}=="505b", MODE="0660", TAG+="uaccess"
# uinput: virtual device that re-injects the filtered events
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
